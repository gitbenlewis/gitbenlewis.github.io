{% assign username = include.username | strip %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ username }}">
    <img
      class="rounded-circle"
      alt="{{ username }}"
      src="https://github.com/{{ username }}.png?size=320"
      width="160"
      height="160"
      loading="lazy"
    >
  </a>
</div>
